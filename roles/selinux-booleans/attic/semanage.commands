semanage fcontext -a -t httpd_sys_rw_content_t "/usr/local/www(/.*)?"
semanage port -m -t http_port_t -p tcp 8080
semanage permissive -a rsync_t
setsebool -P rsync_full_access on
semanage permissive -a zabbix_agent_t
semanage fcontext -a -t httpd_sys_rw_content_t /var/log/php.log
restorecon /var/log/php.log
semanage fcontext -a -t antivirus_db_t /var/log/clamd.scan
restorecon /var/log/clamd.scan

semanage fcontext -a -t mail_spool_t /home/mail
restorecon -Rv /home/mail



semanage fcontext -a -f a -t httpd_sys_content_t /etc/postfixadmin/
restorecon -Rv /etc/postfixadmin/
semanage fcontext -a -f a -t httpd_sys_content_t /usr/share/postfixadmin/
restorecon -Rv /usr/share/postfixadmin/

